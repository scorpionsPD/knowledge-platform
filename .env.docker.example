# Docker environment variables template
# Copy this file to .env and fill in your values

# Database Configuration
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# Session Configuration
SESSION_SECRET=your_very_secure_random_string_min_32_chars

# Frontend Configuration
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# OAuth Configuration (optional - leave commented for development)
# OAUTH_CLIENT_ID=your_oauth_client_id
# OAUTH_CLIENT_SECRET=your_oauth_client_secret
# OAUTH_AUTH_URL=https://your-provider.com/authorize
# OAUTH_TOKEN_URL=https://your-provider.com/oauth/token
# OAUTH_CALLBACK_URL=http://localhost:4000/auth/callback
# OAUTH_USERINFO_URL=https://your-provider.com/userinfo

# Development Mode (set to true to bypass OAuth)
AUTH_DISABLED=true
