PORT=4000
# Postgres connection string (required for Prisma + session store)
DATABASE_URL="postgres://postgres:postgres@localhost:5432/knowledge_platform"
SESSION_SECRET="replace-me"

# OAuth / SSO (Auth0/Okta/Entra/etc.)
# OAUTH_AUTH_URL="https://your-issuer/authorize"
# OAUTH_TOKEN_URL="https://your-issuer/oauth/token"
# OAUTH_CALLBACK_URL="http://localhost:4000/auth/callback"
# OAUTH_USERINFO_URL="https://your-issuer/userinfo"
# OAUTH_CLIENT_ID=""
# OAUTH_CLIENT_SECRET=""

# Dev bypass for local testing without OAuth
# AUTH_DISABLED=true

# Allow CORS from your frontend origin
FRONTEND_ORIGIN="http://localhost:3000"
